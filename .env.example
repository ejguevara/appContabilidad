# Puerto del servidor
PORT=3000

# Conexion a PostgreSQL (crea tu propia base local "app_contable" y pon
# aqui tus propias credenciales - este archivo es solo de ejemplo, tu
# archivo real se llama ".env" y no se sube a GitHub).
PGHOST=localhost
PGPORT=5432
PGDATABASE=app_contable
PGUSER=postgres
PGPASSWORD=tu_contraseña_de_postgres

# Alternativa: una sola cadena de conexion (si existe, tiene prioridad sobre las PG* de arriba)
DATABASE_URL=

# Secreto usado para firmar los tokens de sesion (JWT). Pon cualquier
# texto largo y unico, no hace falta que sea el mismo en cada maquina.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto

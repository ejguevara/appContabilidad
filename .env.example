# Copia este archivo como ".env" y llena tus propios valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# Puerto del servidor
PORT=3000

# Conexion a PostgreSQL local
PGHOST=localhost
PGPORT=5432
PGDATABASE=app_contable
PGUSER=postgres
PGPASSWORD=tu_contrasena_de_postgres

# Alternativa: una sola cadena de conexion (si existe, tiene prioridad sobre las PG* de arriba)
# DATABASE_URL=postgresql://postgres:tu_contrasena@localhost:5432/app_contable

# Clave para firmar las sesiones (JWT). Pon cualquier texto largo y dificil de adivinar.
JWT_SECRET=cambia_esto_por_un_texto_largo_y_secreto

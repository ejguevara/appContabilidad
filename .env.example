# Puerto del servidor
PORT=3000

# Credenciales del Service Account de Firebase
# (Firebase Console > Configuracion del proyecto > Cuentas de servicio > Generar nueva clave privada)
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=tu-service-account@tu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

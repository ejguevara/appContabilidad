rules_version = '2';

// Cualquier usuario que haya iniciado sesion (Firebase Auth) puede leer y
// escribir todas las colecciones de la app por igual. No hay roles ni
// permisos distintos entre usuarios todavia (regla de negocio actual del
// equipo). Un visitante sin sesion no puede leer ni escribir nada.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cuentas/{cuentaId} {
      allow read, write: if request.auth != null;
    }
    match /partidas/{partidaId} {
      allow read, write: if request.auth != null;
    }
    match /movimientos/{movId} {
      allow read, write: if request.auth != null;
    }
    match /kardex/{kardexId} {
      allow read, write: if request.auth != null;
    }
  }
}
